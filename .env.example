# ---- Browser (public) settings: Firebase web app config (Firebase console > Project settings > Your apps) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# ---- Server-only secrets (never prefixed with VITE_) ----
# Same Firebase project id, used to verify sign-in tokens on the server.
FIREBASE_PROJECT_ID=
# Only these Google accounts may use the AI and speech services (comma separated). Empty = anyone signed in.
ALLOWED_EMAILS=
# Azure AI Speech resource (Azure portal > your Speech resource > Keys and Endpoint)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Anthropic API key (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=
# Optional: model for the tutor. Default claude-opus-5-5. Cheaper: claude-sonnet-5-5 or claude-haiku-5-5.
TUTOR_MODEL=
# Local development only: let the API work without Firebase sign-in. Never set this on Vercel.
ALLOW_UNAUTHENTICATED=
